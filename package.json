{
  "name": "breast-tnm-tool",
  "version": "1.0.4",
  "description": "Desktop and mobile web app for breast cancer TNM staging and molecular subtype stratification | 乳腺癌 TNM 分期桌面与移动网页工具",
  "main": "main.js",
  "author": {
    "name": "shbsrh"
  },
  "homepage": "https://github.com/liqi3333/breast/releases/latest",
  "repository": {
    "type": "git",
    "url": "https://github.com/liqi3333/breast.git"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:html": "node scripts/build-html-release.js",
    "capture:screenshots": "electron scripts/capture-screenshots.js"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.openclaw.breast-tnm-tool",
    "productName": "Breast TNM Tool",
    "copyright": "Copyright © 2026 shbsrh",
    "artifactName": "Breast-TNM-Tool-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "index.html",
      "mobile.html"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "legalTrademarks": "shbsrh",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
